# Pinned versions used by install.sh (never :latest; see SwitchBoardChat docs/homeserver.md).
# Updating one of these and re-running install.sh upgrades that component. A value set in
# composer.env (e.g. SYNAPSE_IMAGE=...) overrides the one here.
SYNAPSE_IMAGE=matrixdotorg/synapse:v1.165.0
MAS_IMAGE=ghcr.io/element-hq/matrix-authentication-service:1.29.0
POSTGRES_IMAGE=postgres:17-alpine
NGINX_IMAGE=nginx:1.30-alpine
CERTBOT_IMAGE=certbot/certbot:v5.10.0
CURL_IMAGE=curlimages/curl:8.17.0
