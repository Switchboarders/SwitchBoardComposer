# Copy to ~/.config/sbcomposer/nightly.env (chmod 600) and fill in.

# Failure issues: GitHub repository (owner/name) where `gh` (logged in on this machine) may open issues.
ISSUE_REPO=

# Failure emails, sent with curl over SMTP (STARTTLS on 587, or smtps:// on 465).
MAIL_TO=
MAIL_FROM=
SMTP_URL=smtp://smtp.gmail.com:587
SMTP_USER=
SMTP_PASSWORD=

# Distributions tested in rotation, besides debian every night.
# ROTATE="ubuntu fedora arch alpine"

# The live installation of this machine, updated to main and fully tested every night (tests/suite.sh:
# test accounts, a test call center, a short restart of the services). Leave empty for none.
# LIVE_PREFIX=/home/carl/switchboard
# LIVE_UPDATE=1          # 0: test it without updating it first
# LIVE_OUTSIDE=local     # or an ssh host on another network for the outside checks
